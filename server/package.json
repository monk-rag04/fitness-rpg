{
  "name": "@fitness-rpg/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/devStartup.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "start": "node dist/productionStartup.js",
    "smoke:openai": "node --env-file-if-exists=.env dist/smokeOpenAI.js"
  },
  "dependencies": {
    "@fitness-rpg/shared": "0.1.0",
    "express": "^5.2.1",
    "openai": "^7.20.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
